#!name=One Exit
#!desc=Claude、Google、Persona 走备注为 SG_Residential 的住宅节点

[Rule]
# 住宅代理连 2607:6bc0 会 502。这两条放在域名规则前面，拒绝 IPv6，让客户端改走 IPv4。
IP-CIDR6,2607:6bc0::/48,REJECT,no-resolve
IP-CIDR6,2607:6bc0:11::/48,REJECT,no-resolve
DOMAIN-SUFFIX,claude.ai,SG_Residential
DOMAIN-SUFFIX,claude.com,SG_Residential
DOMAIN-SUFFIX,clau.de,SG_Residential
DOMAIN-SUFFIX,anthropic.com,SG_Residential
DOMAIN-SUFFIX,claudeusercontent.com,SG_Residential
DOMAIN-SUFFIX,claudemcpcontent.com,SG_Residential
DOMAIN-SUFFIX,modelcontextprotocol.io,SG_Residential
DOMAIN-KEYWORD,anthropic,SG_Residential
DOMAIN-KEYWORD,claude,SG_Residential
IP-CIDR,160.79.104.0/21,SG_Residential,no-resolve
IP-ASN,399358,SG_Residential,no-resolve
DOMAIN-SUFFIX,sentry.io,SG_Residential
DOMAIN-KEYWORD,browser-intake,SG_Residential
DOMAIN-SUFFIX,datadoghq.com,SG_Residential
DOMAIN-SUFFIX,growthbook.io,SG_Residential
DOMAIN-SUFFIX,usefathom.com,SG_Residential
DOMAIN-SUFFIX,hcaptcha.com,SG_Residential
DOMAIN-SUFFIX,stripe.com,SG_Residential
DOMAIN-SUFFIX,stripe.network,SG_Residential
DOMAIN-SUFFIX,stripecdn.com,SG_Residential
DOMAIN-SUFFIX,intercom.io,SG_Residential
DOMAIN-SUFFIX,intercomcdn.com,SG_Residential
DOMAIN-SUFFIX,challenges.cloudflare.com,SG_Residential
DOMAIN-SUFFIX,siftscience.com,SG_Residential
DOMAIN-SUFFIX,segment.io,SG_Residential

DOMAIN-SUFFIX,google.com,SG_Residential
DOMAIN-SUFFIX,googleapis.com,SG_Residential
DOMAIN-SUFFIX,gstatic.com,SG_Residential
DOMAIN-SUFFIX,gmail.com,SG_Residential
DOMAIN-SUFFIX,googleusercontent.com,SG_Residential
DOMAIN-SUFFIX,recaptcha.net,SG_Residential

DOMAIN-SUFFIX,withpersona.com,SG_Residential

DOMAIN-SUFFIX,webshare.io,SG_Residential

# 相关功能统一走住宅出口；用途和网络核对见 docs/service-domains.md。
# 同一域名上的其他软件流量也会走住宅出口。

# Claude Code 更新说明下载。
DOMAIN,raw.githubusercontent.com,SG_Residential

# GitHub 授权、插件/插件市场下载，以及仓库、PR 等 API 请求。
DOMAIN,github.com,SG_Residential
DOMAIN,api.github.com,SG_Residential

# Google CDN：包括 Linux 拼写字典下载及其 gvt1.com 子域名跳转。
DOMAIN-SUFFIX,gvt1.com,SG_Residential

# 图表、预览或网页内容引用的第三方程序库和模块。
DOMAIN,cdnjs.cloudflare.com,SG_Residential
DOMAIN,cdn.jsdelivr.net,SG_Residential
DOMAIN,esm.sh,SG_Residential
DOMAIN,unpkg.com,SG_Residential

# Microsoft Entra 登录，例如 Foundry 使用 Entra 身份验证时。
DOMAIN,login.microsoftonline.com,SG_Residential
